# Image tag to run (X.Y.Z, no "v"). On the VPS, the release workflow rewrites this line in .env.
NODBEAT_VERSION=0.10.0
# MongoDB connection string. The database name in the path is used (e.g. /nodbeat).
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/nodbeat
# Public URL nodbeat is served at; used to build Heartbeat URLs and the Telegram webhook.
PUBLIC_BASE_URL=https://nodbeat.g2labs.pl
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional: external dead-man's-switch URL nodbeat sends its own Heartbeat to every minute (e.g. healthchecks.io).
SELF_HEARTBEAT_URL=
